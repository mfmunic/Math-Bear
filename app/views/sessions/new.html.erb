<h1 class="text-center mb-5">Create New Session</h1>

<div class="d-flex justify-content-center">
    <div class="col-md-4" style="box-shadow: 1px 1px 4px grey;
        padding: 24px;
        border-radius: 16px;
        border: 8px solid green;">
        <%= form_with(model: @session, local: true) do |f| %>
        <div class="mb-3">
            <%= f.label :session_type, "Type", class: "form-label" %>
            <%= f.select :session_type,
                options_for_select([["Timed", "timed"], ['Count', 'count']], @session.session_type),
                {},
                class: "form-select" %>
        </div>

        <div class="mb-3">
            <%= f.label :max_input, "Maximum Number", class: "form-label" %>
            <%= f.number_field :max_input,
                class: "form-control",
                min: 1 %>
        </div>

        <div class="mb-3">
            <%= f.label :min_input, "Minimum Number", class: "form-label" %>
            <%= f.number_field :min_input,
                class: "form-control",
                min: 0 %>
        </div>

        <div class="mb-3">
            <%= f.label :time_minutes, "Minutes", class: "form-label" %>
            <%= f.number_field :time_minutes,
                class: "form-control",
                min: 1 %>
        </div>

        <div class="form-check mb-3">
            <%= f.check_box :addition, class: "form-check-input" %>
            <%= f.label :addition, "Include Addition", class: "form-check-label" %>
        </div>

        <div class="form-check mb-3">
            <%= f.check_box :subtraction, class: "form-check-input" %>
            <%= f.label :subtraction, "Include Subtraction", class: "form-check-label" %>
        </div>

        <div class="form-check mb-3">
            <%= f.check_box :multiplication, class: "form-check-input" %>
            <%= f.label :multiplication, "Include Multiplication", class: "form-check-label" %>
        </div>

        <div class="form-check mb-3">
            <%= f.check_box :subtraction, class: "form-check-input" %>
            <%= f.label :subtraction, "Include Subtraction", class: "form-check-label" %>
        </div>

        <div class="d-flex" style="justify-content: space-between">
                <div>
                    <%= f.submit class: "btn btn-primary" %>
                </div>
                <div>
                    <%= link_to "Cancel", sessions_path, class: "btn btn-secondary" %>
                </div>
                <% end %>
            </div>
        </div>
</div>